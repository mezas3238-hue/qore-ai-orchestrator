{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qore.fable.audit.package.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "audit_mode",
    "audit_reasons",
    "system_freeze",
    "primary_candidate_id",
    "primary_candidate",
    "changed_since_last_audit",
    "dependency_graph",
    "authority_graph",
    "trust_boundaries",
    "data_flows",
    "ai_orchestration_graph",
    "contracts",
    "invariants",
    "forbidden_transitions",
    "qg_evidence",
    "known_attack_surfaces",
    "source_index",
    "symbol_index",
    "cross_component_interfaces",
    "prior_audit_evidence_refs",
    "hard_budget_usd",
    "instructions",
    "output_contract",
    "production_authority",
    "shadow_only",
    "package_sha256",
    "package_id"
  ],
  "properties": {
    "schema_version": {"const": "qore.fable.audit.package.v1"},
    "audit_mode": {"enum": ["DELTA", "CROSS_BOUNDARY", "FULL_SYSTEM"]},
    "audit_reasons": {"type": "array", "items": {"type": "string"}},
    "system_freeze": {"type": "object"},
    "primary_candidate_id": {"type": "string", "minLength": 1},
    "primary_candidate": {"type": "object"},
    "changed_since_last_audit": {"type": "array", "items": {"type": "object"}},
    "dependency_graph": {"type": "object"},
    "authority_graph": {"type": "object"},
    "trust_boundaries": {"type": "array", "items": {"type": "object"}},
    "data_flows": {"type": "array", "items": {"type": "object"}},
    "ai_orchestration_graph": {"type": "object"},
    "contracts": {"type": "array", "items": {"type": "object"}},
    "invariants": {"type": "array", "items": {"type": "string"}},
    "forbidden_transitions": {"type": "array", "items": {"type": "string"}},
    "qg_evidence": {"type": "array", "items": {"type": "object"}},
    "known_attack_surfaces": {"type": "array", "items": {"type": "string"}},
    "source_index": {"type": "array", "items": {"type": "object"}},
    "symbol_index": {"type": "array", "items": {"type": "object"}},
    "cross_component_interfaces": {"type": "array", "items": {"type": "object"}},
    "prior_audit_evidence_refs": {"type": "array", "items": {"type": "string"}},
    "hard_budget_usd": {"type": "number", "minimum": 0},
    "instructions": {"type": "string", "minLength": 1},
    "output_contract": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "production_authority": {"const": false},
    "shadow_only": {"const": true},
    "package_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "package_id": {"type": "string", "pattern": "^QORE-FABLE-AUDIT-[0-9a-f]{24}$"}
  }
}

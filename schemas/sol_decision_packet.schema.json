{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qore.sol.decision.packet.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate_id",
    "candidate",
    "risk_tier",
    "risk_reasons",
    "workflow_state",
    "last_event",
    "decision_required",
    "active_contract",
    "open_semantic_questions",
    "changed_files",
    "diff_summary",
    "findings",
    "qg_summary",
    "review_summary",
    "source_slices",
    "budget_remaining_usd",
    "allowed_transitions",
    "production_authority",
    "packet_sha256",
    "packet_id"
  ],
  "properties": {
    "schema_version": {"const": "qore.sol.decision.packet.v1"},
    "candidate_id": {"type": "string", "minLength": 1},
    "candidate": {"type": "object"},
    "risk_tier": {"type": "integer", "minimum": 0, "maximum": 4},
    "risk_reasons": {"type": "array", "items": {"type": "string"}},
    "workflow_state": {"type": "string", "minLength": 1},
    "last_event": {"type": "string", "minLength": 1},
    "decision_required": {"type": "string", "minLength": 1},
    "active_contract": {"type": "object"},
    "open_semantic_questions": {"type": "array", "items": {"type": "string"}},
    "changed_files": {"type": "array", "items": {"type": "string"}},
    "diff_summary": {"type": "object"},
    "findings": {"type": "object"},
    "qg_summary": {"type": "object"},
    "review_summary": {"type": "object"},
    "source_slices": {"type": "array", "items": {"type": "object"}},
    "budget_remaining_usd": {"type": "number", "minimum": 0},
    "allowed_transitions": {"type": "array", "items": {"type": "string"}},
    "production_authority": {"const": false},
    "packet_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "packet_id": {"type": "string", "pattern": "^QORE-SOL-PKT-[0-9a-f]{24}$"}
  }
}

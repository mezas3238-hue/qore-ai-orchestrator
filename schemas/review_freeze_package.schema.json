{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qore.review.freeze.package.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate_id",
    "candidate",
    "reviewer_role",
    "contract_version",
    "changed_file_manifest",
    "exact_diff",
    "changed_file_contents",
    "semantic_dependency_slices",
    "architecture_invariants",
    "qg_evidence",
    "adversarial_evidence",
    "prior_finding_closure",
    "questions",
    "prohibited_conclusions",
    "reviewer_independence",
    "production_authority",
    "packet_sha256",
    "packet_id"
  ],
  "properties": {
    "schema_version": {"const": "qore.review.freeze.package.v1"},
    "candidate_id": {"type": "string", "minLength": 1},
    "candidate": {"type": "object"},
    "reviewer_role": {"type": "string", "minLength": 1},
    "contract_version": {"type": "string", "minLength": 1},
    "changed_file_manifest": {"type": "array", "items": {"type": "object"}},
    "exact_diff": {"type": "string"},
    "changed_file_contents": {"type": "array", "items": {"type": "object"}},
    "semantic_dependency_slices": {"type": "array", "items": {"type": "object"}},
    "architecture_invariants": {"type": "array", "items": {"type": "string"}},
    "qg_evidence": {"type": "object"},
    "adversarial_evidence": {"type": "array", "items": {"type": "object"}},
    "prior_finding_closure": {"type": "array", "items": {"type": "object"}},
    "questions": {"type": "array", "items": {"type": "string"}},
    "prohibited_conclusions": {"type": "array", "items": {"type": "string"}},
    "reviewer_independence": {"type": "string", "minLength": 1},
    "production_authority": {"const": false},
    "packet_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "packet_id": {"type": "string", "pattern": "^QORE-REVIEW-FREEZE-[0-9a-f]{24}$"}
  }
}

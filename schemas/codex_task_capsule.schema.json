{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qore.codex.task.capsule.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate_id",
    "candidate",
    "source_sha",
    "reference_sha",
    "reference_materialized",
    "changed_file_allowlist",
    "forbidden_files",
    "contract",
    "findings",
    "acceptance_tests",
    "source_slices",
    "relevant_tests",
    "historical_delta",
    "missing_evidence_protocol",
    "production_authority",
    "packet_sha256",
    "packet_id"
  ],
  "properties": {
    "schema_version": {"const": "qore.codex.task.capsule.v1"},
    "candidate_id": {"type": "string", "minLength": 1},
    "candidate": {"type": "object"},
    "source_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "reference_sha": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
    "reference_materialized": {"type": "boolean"},
    "changed_file_allowlist": {"type": "array", "items": {"type": "string"}},
    "forbidden_files": {"type": "array", "items": {"type": "string"}},
    "contract": {"type": "object"},
    "findings": {"type": "array", "items": {"type": "object"}},
    "acceptance_tests": {"type": "array", "items": {"type": "string"}},
    "source_slices": {"type": "array", "items": {"type": "object"}},
    "relevant_tests": {"type": "array", "items": {"type": "string"}},
    "historical_delta": {"type": "object"},
    "missing_evidence_protocol": {"const": "NEED_EVIDENCE(symbol/file/test)"},
    "production_authority": {"const": false},
    "packet_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "packet_id": {"type": "string", "pattern": "^QORE-CODEX-CAPS-[0-9a-f]{24}$"}
  }
}
